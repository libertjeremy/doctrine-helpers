{
    "name": "libertjeremy/doctrine-helpers",
    "type": "library",
    "authors": [
        {
            "name": "libertjeremy",
            "email": "contact@libertjeremy.fr"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/orm": "^2.15 || ^3.3",
        "symfony/doctrine-bridge": "^7.2",
        "symfony/uid": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "LibertJeremy\\Doctrine\\Helpers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibertJeremy\\Doctrine\\Helpers\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    }
}
